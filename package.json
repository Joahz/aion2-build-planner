{
  "name": "aion2-build-planner",
  "version": "1.1.0",
  "description": "Aion 2 character planner for Assassin and Ranger: skills, gear, rotation and macros",
  "author": "Aion 2 Build Planner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "life.aion2.buildplanner",
    "productName": "Aion 2 Build Planner",
    "files": ["main.js", "app/**/*", "data/**/*", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "Aion2BuildPlanner.exe" },
    "directories": { "output": "dist" }
  }
}
